<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <h2 class="fw-semibold mb-4"><%= title %></h2>

        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="card shadow-sm">
          <div class="card-body p-4">
            <form method="POST" action="<%= formAction %>" novalidate>
              <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input
                  type="text"
                  class="form-control"
                  id="title"
                  name="title"
                  required
                  value="<%= task && task.title ? task.title : '' %>"
                  autofocus
                />
              </div>

              <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea class="form-control" id="description" name="description" rows="3"><%= task && task.description ? task.description : '' %></textarea>
              </div>

              <div class="row">
                <div class="col-md-4 mb-3">
                  <label for="status" class="form-label">Status</label>
                  <select class="form-select" id="status" name="status">
                    <% ['Pending', 'In Progress', 'Completed'].forEach(function(s) { %>
                      <option value="<%= s %>" <%= (task && task.status === s) ? 'selected' : '' %>><%= s %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="col-md-4 mb-3">
                  <label for="priority" class="form-label">Priority</label>
                  <select class="form-select" id="priority" name="priority">
                    <% ['Low', 'Medium', 'High'].forEach(function(p) { %>
                      <option value="<%= p %>" <%= (task && task.priority === p) ? 'selected' : (p === 'Medium' && !task ? 'selected' : '') %>><%= p %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="col-md-4 mb-3">
                  <label for="dueDate" class="form-label">Due Date</label>
                  <input
                    type="date"
                    class="form-control"
                    id="dueDate"
                    name="dueDate"
                    value="<%= task && task.dueDate ? new Date(task.dueDate).toISOString().substring(0,10) : '' %>"
                  />
                </div>
              </div>

              <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select class="form-select" id="category" name="category">
                  <option value="">-- No category --</option>
                  <% categories.forEach(function(cat) { %>
                    <%
                      const taskCategoryId = task && task.category
                        ? (task.category._id ? task.category._id.toString() : task.category.toString())
                        : '';
                    %>
                    <option value="<%= cat._id %>" <%= taskCategoryId === cat._id.toString() ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <% if (currentUser.role === 'admin' && users && users.length) { %>
                <div class="mb-4">
                  <label for="assignedUser" class="form-label">Assigned User</label>
                  <select class="form-select" id="assignedUser" name="assignedUser">
                    <% users.forEach(function(u) { %>
                      <%
                        const taskUserId = task && task.user
                          ? (task.user._id ? task.user._id.toString() : task.user.toString())
                          : currentUser.userId;
                      %>
                      <option value="<%= u._id %>" <%= taskUserId === u._id.toString() ? 'selected' : '' %>>
                        <%= u.username %> (<%= u.email %>)
                      </option>
                    <% }); %>
                  </select>
                  <div class="form-text">As an admin, you can assign this task to any user.</div>
                </div>
              <% } %>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                  <%= task ? 'Save Changes' : 'Create Task' %>
                </button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
