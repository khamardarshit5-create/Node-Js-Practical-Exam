<%
  // Reusable task item partial.
  // Expected locals: task, isAdminView
  const statusColors = { 'Pending': 'warning', 'In Progress': 'primary', 'Completed': 'success' };
  const priorityColors = { 'Low': 'secondary', 'Medium': 'warning', 'High': 'danger' };
  const statusBadge = statusColors[task.status] || 'secondary';
  const priorityBadge = priorityColors[task.priority] || 'secondary';
%>
<div class="col-md-6 col-lg-4">
  <div class="card task-card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <h5 class="card-title mb-0"><%= task.title %></h5>
        <span class="badge bg-<%= priorityBadge %>"><%= task.priority %></span>
      </div>
      <p class="card-text text-muted small flex-grow-1">
        <%= task.description && task.description.length ? task.description : 'No description provided.' %>
      </p>
      <div class="mb-2">
        <span class="badge bg-<%= statusBadge %>"><%= task.status %></span>
        <% if (task.category && task.category.name) { %>
          <span class="badge bg-light text-dark border"><%= task.category.name %></span>
        <% } %>
      </div>
      <div class="small text-muted mb-2">
        <% if (task.dueDate) { %>
          <i class="bi bi-calendar-event me-1"></i>Due: <%= new Date(task.dueDate).toLocaleDateString() %>
        <% } else { %>
          <i class="bi bi-calendar-event me-1"></i>No due date
        <% } %>
      </div>
      <% if (isAdminView && task.user) { %>
        <div class="small text-muted mb-2">
          <i class="bi bi-person me-1"></i>Assigned to: <strong><%= task.user.username %></strong>
        </div>
      <% } %>
      <div class="d-flex gap-2 mt-auto pt-2">
        <a href="/tasks/<%= task._id %>/edit" class="btn btn-sm btn-outline-primary flex-fill">
          <i class="bi bi-pencil-square"></i> Edit
        </a>
        <form
          action="/tasks/<%= task._id %>/delete"
          method="POST"
          class="flex-fill"
          onsubmit="return confirm('Are you sure you want to delete this task?');"
        >
          <button type="submit" class="btn btn-sm btn-outline-danger w-100">
            <i class="bi bi-trash"></i> Delete
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
