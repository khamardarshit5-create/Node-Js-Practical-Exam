<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <h2 class="fw-semibold mb-4"><%= title %></h2>

        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="card shadow-sm">
          <div class="card-body p-4">
            <form method="POST" action="<%= formAction %>" novalidate>
              <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input
                  type="text"
                  class="form-control"
                  id="name"
                  name="name"
                  required
                  value="<%= category && category.name ? category.name : '' %>"
                  autofocus
                />
              </div>
              <div class="mb-4">
                <label for="description" class="form-label">Description</label>
                <textarea class="form-control" id="description" name="description" rows="3"><%= category && category.description ? category.description : '' %></textarea>
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                  <%= category ? 'Save Changes' : 'Create Category' %>
                </button>
                <a href="/categories" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
