<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <h2 class="fw-semibold mb-0"><%= heading %></h2>
        <p class="text-muted mb-0">Signed in as <%= currentUser.username %></p>
      </div>
      <a href="/tasks/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Task
      </a>
    </div>

    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (!tasks || tasks.length === 0) { %>
      <div class="empty-state text-center py-5">
        <i class="bi bi-clipboard-check display-4 text-muted"></i>
        <p class="text-muted mt-3 mb-3">No tasks found yet.</p>
        <a href="/tasks/new" class="btn btn-primary">Create your first task</a>
      </div>
    <% } else { %>
      <div class="row g-3">
        <% tasks.forEach(function(task) { %>
          <%- include('taskItem', { task: task, isAdminView: isAdminView }) %>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
