<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="auth-wrapper d-flex align-items-center justify-content-center">
    <div class="card auth-card shadow-sm">
      <div class="card-body p-4 p-md-5">
        <h3 class="card-title text-center mb-4 fw-semibold">Create Account</h3>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success py-2"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger py-2"><%= error %></div>
        <% } %>

        <form method="POST" action="/register" novalidate>
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input
              type="text"
              class="form-control"
              id="username"
              name="username"
              value="<%= (typeof formData !== 'undefined' && formData.username) ? formData.username : '' %>"
              required
              minlength="3"
              autofocus
            />
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              value="<%= (typeof formData !== 'undefined' && formData.email) ? formData.email : '' %>"
              required
            />
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" required minlength="6" />
          </div>
          <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirm Password</label>
            <input
              type="password"
              class="form-control"
              id="confirmPassword"
              name="confirmPassword"
              required
              minlength="6"
            />
          </div>
          <!-- Note: role is intentionally NOT included. All registrations are 'user' by default. -->
          <button type="submit" class="btn btn-primary w-100">Register</button>
        </form>

        <p class="text-center mt-4 mb-0 small">
          Already have an account? <a href="/login">Login here</a>
        </p>
      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
